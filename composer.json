{
    "name": "turbo-addons/turbo-guard",
    "description": "Turbo Guard WordPress Security Plugin",
    "type": "wordpress-plugin",
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "TurboGuard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {},
        "platform": {
            "php": "8.2"
        }
    }
}
